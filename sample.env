TADIL_DB=
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=
MINIO_BUCKET=

TADIL_API=
TADIL_MOBILE_API=

JWT_SECRET=super-secret

# Moyasar Payment
VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_placeholder
MOYASAR_SECRET_KEY=sk_test_placeholder
VITE_GOOGLE_PAY_MERCHANT_ID=

# Staff authentication (use the exact frontend origin; comma-separated).
STAFF_ALLOWED_ORIGINS=http://localhost:4000
# Set true behind HTTPS in production. Never disable in production.
STAFF_SESSION_SECURE=false

# Firebase push notifications (both APIs). Either a path to the service
# account JSON, or the JSON itself (raw or base64) for hosts like Railway.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Google Maps browser key (Maps JavaScript API + Geocoding API). Required for the address map picker.
VITE_GOOGLE_MAPS_KEY=
