{
  "name": "tadil-notifications",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "sourceRoot": "libs/infra/tadil-notifications/src",
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx jest -c libs/infra/tadil-notifications/jest.config.cjs"
        }
      }
    }
  }
}
